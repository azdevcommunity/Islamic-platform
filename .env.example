# Environment Configuration Example
# Copy this file to .env.local and fill in your values

# Node Environment
APP_ENV_NODE_ENV=development

# API Base URLs
NEXT_PUBLIC_BASE_URL=http://localhost:8075/api
NEXT_PUBLIC_BASE_URL_YTB=https://api-ytb.nizamiyyemedresesi.az/api

# Social Media Channel URLs
NEXT_PUBLIC_YTB_CHANNEL_URL=https://youtube.com/channel/YOUR_CHANNEL_ID
NEXT_PUBLIC_WP_CHANNEL_URL=https://whatsapp.com/channel/YOUR_CHANNEL_ID
NEXT_PUBLIC_INSTAGRAM_CHANNEL_URL=https://www.instagram.com/YOUR_USERNAME
NEXT_PUBLIC_TIKTOK_CHANNEL_URL=https://www.tiktok.com/@YOUR_USERNAME
NEXT_PUBLIC_FACEBOOK_CHANNEL_URL=https://www.facebook.com/YOUR_PAGE

# YouTube Default Playlist
DEFAULT_PLAYLIST_ID=YOUR_PLAYLIST_ID

# Cache Revalidation Secret Token (generate with: openssl rand -base64 32)
# Used for API-based cache invalidation
REVALIDATE_SECRET_TOKEN=your-super-secret-token-here

# Production API URLs (uncomment for production)
# NEXT_PUBLIC_BASE_URL=https://api.nizamiyyemedresesi.az/api
# NEXT_PUBLIC_BASE_URL_YTB=https://api-ytb.nizamiyyemedresesi.az/api

# Sentry Configuration
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-here
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here
